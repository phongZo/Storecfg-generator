<UserControl x:Class="StorecfgGenerator.JsonPreviewTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Background="{StaticResource SurfaceColor}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="32,32,32,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <!-- Title Section -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="JSON Configuration" 
                           FontSize="26" 
                           FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimaryColor}" 
                           Margin="0,0,0,8"/>
                <TextBlock Text="Preview and edit your configuration in JSON format" 
                           FontSize="14" 
                           Foreground="{StaticResource TextMutedColor}" 
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                <Button x:Name="btnFormat" 
                        Margin="0,0,12,0" 
                        Click="FormatJson_Click"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M4 6h16v2H4zm0 5h16v2H4zm0 5h16v2H4z" 
                              Fill="{StaticResource TextSecondaryColor}" 
                              Stretch="Uniform" 
                              Width="14" 
                              Height="14"
                              Margin="0,0,6,0"/>
                        <TextBlock Text="Format" 
                                   FontSize="13" 
                                   FontWeight="Medium"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnApply" 
                        Click="ApplyJson_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="90" Height="32">
                    <DockPanel>
                        <Image Source="../../Icon/check-solid.png" Height="15" Margin="0,0,5,0"/>
                        <TextBlock Text="Apply" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Border Grid.Row="1" 
                Style="{StaticResource CardStyle}" 
                Margin="32,0,32,32">
            <Grid>
                <!-- JSON Editor -->
                <ScrollViewer 
                              VerticalScrollBarVisibility="Auto"  
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="24,24,24,24">
                    <Border Background="#FAFAFA" 
                            BorderThickness="1" 
                            BorderBrush="#E5E7EB" 
                            CornerRadius="8"
                            Padding="20,16">
                        <TextBox x:Name="txtJsonPreview" 
                                 AcceptsReturn="True" 
                    TextWrapping="Wrap" 
                                 FontFamily="JetBrains Mono, Consolas, Monaco, 'Courier New'" 
                                 FontSize="13"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#1F2937"
                                 Padding="0"
                                 TextChanged="txtJsonPreview_TextChanged"
                                 AcceptsTab="True"
                                 SpellCheck.IsEnabled="False"/>
                    </Border>
            </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
