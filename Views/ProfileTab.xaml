<UserControl x:Class="StorecfgGenerator.ProfileTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:SubtractConverter x:Key="SubtractConverter"/>
            <local:TimeFormatConverter x:Key="TimeFormatConverter"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
            <local:ConditionMethodToLabelAndVisible x:Key="ConditionMethodToLabelAndVisible"/>
            <local:MethodToProtocolConverter x:Key="MethodToProtocolConverter"/>
            <local:ConditionMethodToDnsAddressVisibility x:Key="ConditionMethodToDnsAddressVisibility"/>
            <local:ConditionMethodToShowTimeoutVisibility x:Key="ConditionMethodToShowTimeoutVisibility"/>
            <local:ConditionWaitToVisibility x:Key="ConditionWaitToVisibility"/>
            <local:MillisecondsToSecondsConverter x:Key="MillisecondsToSecondsConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Auto"
                  Background="{StaticResource SurfaceColor}">
        <StackPanel Margin="24">
            <!-- Header Section -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="{StaticResource SurfaceColor}" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1" 
                    Margin="0,0,0,24">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Profile Configuration" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryColor}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Configure your profile settings and preferences below" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondaryColor}" 
                               Opacity="0.9" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Basic Settings -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Basic Settings" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>

                    <Grid Margin="-32,16,0,0" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <Grid Grid.Column="0" Margin="-16,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LeftLabels"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Show System Tray:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton x:Name="Toggle2" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.ShowSystemTray}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Screen Capture With Watermark:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.ScreenCaptureWithWatermark}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Screen Sharing With Watermark:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.ScreenSharingWithWatermark}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Window Sharing With Watermark:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.WindowSharingWithWatermark}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Presentation Mode With Watermark:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.PresentationModeWithWatermark}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Message Of The Day:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.MessageOfTheDay}"/>
                        </Grid>

                        <!-- Right Column -->
                        <Grid Grid.Column="2" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="RightLabels"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Bypass Watermark:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.BypassWatermark}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Encrypt Store File:" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap" Margin="0,12,12,0"/>
                            <ToggleButton Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0" Style="{StaticResource ModernToggleButtonStyle}" IsChecked="{Binding Profile.EncryptStoreFile}"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                                <TextBlock Text="Wait Time (s):" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <TextBox x:Name="WaitTimeTextBox"
                                     Grid.Row="2" Grid.Column="1"
                                     Tag="required|Wait Time (s)"
                                     PreviewTextInput="TextBox_PreviewTextInput"
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Width="80" MinHeight="32" VerticalContentAlignment="Center" Padding="8,4" 
                                     HorizontalAlignment="Left" Margin="0,12,0,0"
                                     Text="{Binding Profile.WaitTime}"/>

                            <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                                <TextBlock Text="Refresh Interval (s):" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <TextBox x:Name="RefreshIntervalTextBox"
                                     Grid.Row="3" Grid.Column="1"
                                     Tag="required|Refresh Interval (s)"
                                     PreviewTextInput="TextBox_PreviewTextInput"
                                     Style="{StaticResource ModernTextBoxStyle}" 
                                     Width="80" MinHeight="32" VerticalContentAlignment="Center" Padding="8,4" 
                                     HorizontalAlignment="Left" Margin="0,12,0,0"
                                     Text="{Binding Profile.SlowRefreshInterval, Converter={StaticResource MillisecondsToSecondsConverter}, UpdateSourceTrigger=PropertyChanged}"/>

                            <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,12,0">
                                <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                                <TextBlock Text="Maximum Log Size:" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,12,0,0">
                                <TextBox x:Name="MaxLogSizeTextBox"
                                         Tag="required|Maximum Log Size (MB)"
                                         PreviewTextInput="TextBox_PreviewTextInput"
                                         Style="{StaticResource ModernTextBoxStyle}" 
                                         Width="80" MinHeight="32" VerticalContentAlignment="Center" Padding="8,4"
                                         Text="{Binding Profile.LogRotation.size}"/>
                                <TextBlock Text="(MB)" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="Black"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Conditions Section -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Condition Flows" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>
                    <local:Conditions/>
                </StackPanel>
            </Border>

            <!-- Advanced Condition Check Section -->
            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Advanced Condition Check" 
                               Style="{StaticResource SectionHeaderStyle}"/>

                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="Advanced Condition Check setting:" 
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,8,0"/>

                        <ToggleButton x:Name="AdvancedConditionToggle"
                                      Style="{StaticResource ModernToggleButtonStyle}" 
                                      IsChecked="{Binding Profile.AdvancedConditionCheck}"
                                      VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel x:Name="AdvancedConditionPanel" 
                                Margin="0,16,0,0"
                                Visibility="{Binding Profile.AdvancedConditionCheck, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Number of Rechecks -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Number of Rechecks After Initial Condition Check:" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="NumberOfRechecksTextBox"
                                     Width="80" MinHeight="32" VerticalContentAlignment="Center" Padding="8,4" 
                                     PreviewTextInput="TextBox_PreviewTextInput"
                                     Text="{Binding Profile.NumberOfRechecks}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                        <Setter Property="Tag" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profile.AdvancedConditionCheck}" Value="True">
                                                <Setter Property="Tag" Value="required|Number of Rechecks"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>

                        <!-- Recheck Interval -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Recheck Condition Interval:" 
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,8,0"/>
                            <TextBox x:Name="RecheckIntervalTextBox"
                                     Width="80" MinHeight="32" VerticalContentAlignment="Center" Padding="8,4" 
                                     PreviewTextInput="TextBox_PreviewTextInput"
                                     Text="{Binding Profile.RecheckInterval}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBoxStyle}">
                                        <Setter Property="Tag" Value="{x:Null}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Profile.AdvancedConditionCheck}" Value="True">
                                                <Setter Property="Tag" Value="required|Recheck Condition Interval"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
