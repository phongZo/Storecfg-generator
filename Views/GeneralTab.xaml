<UserControl x:Class="StorecfgGenerator.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StorecfgGenerator">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:VisibleForDevMode x:Key="VisibleForDevMode"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  Background="{StaticResource SurfaceColor}">
        <StackPanel Margin="24">
            <!-- Header Section -->
            <Border Style="{StaticResource CardStyle}" 
                    Background="{StaticResource SurfaceColor}" 
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Margin="0,0,0,32">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="../Images/AgileMarkIcon.ico" 
                           Width="64" Height="64" 
                           Stretch="Uniform" 
                           Margin="0,0,0,16"/>
                    <TextBlock Text="Configuration Settings" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryColor}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Configure your store configuration settings below" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondaryColor}" 
                               Opacity="0.9" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Operating System Selection -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Operating System" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>
                    <DockPanel HorizontalAlignment="Left" Margin="0,16,0,0">
                        <RadioButton x:Name="WindowMode" 
                                    Content="Windows" 
                                    IsChecked="True" 
                                    GroupName="OS" 
                                    Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="MacMode" 
                                    Content="Mac" 
                                    GroupName="OS" 
                                    Style="{StaticResource ModernRadioButtonStyle}" 
                                    Margin="32,0,0,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Basic Configuration -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Basic Configuration" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Customer ID -->
                        <StackPanel Orientation="Horizontal" 
                                    Grid.Row="0" 
                                    Grid.Column="0" 
                                    Margin="0,0,16,16" 
                                    VerticalAlignment="Center"
                                    MinWidth="140">
                            <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                            <Label Content="Customer ID:"/>
                        </StackPanel>
                        <TextBox Grid.Row="0" 
                                 Grid.Column="1" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 LostFocus="TextBox_LostFocus" 
                                 TextChanged="TextBox_TextChanged"
                                 Text="{Binding CustomerID}"/>

                        <!-- Client ID -->
                        <StackPanel Orientation="Horizontal" 
                                    Grid.Row="1" 
                                    Grid.Column="0" 
                                    Margin="0,0,16,16" 
                                    VerticalAlignment="Center"
                                    MinWidth="140">
                            <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                            <Label Content="Client ID:"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" 
                                 Grid.Column="1" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 PreviewTextInput="TextBox_PreviewTextInput" 
                                 LostFocus="TextBox_LostFocus"
                                 TextChanged="TextBox_TextChanged" 
                                 Text="{Binding ClientID}"/>

                        <!-- License -->
                        <StackPanel Orientation="Horizontal" 
                                    Grid.Row="2" 
                                    Grid.Column="0" 
                                    Margin="0,0,16,16" 
                                    VerticalAlignment="Center"
                                    MinWidth="140">
                            <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                            <Label Content="License:"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" 
                                 Grid.Column="1" 
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Padding="8,4"
                                 LostFocus="TextBox_LostFocus" 
                                 TextChanged="TextBox_TextChanged"
                                 Text="{Binding License}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Deployment Configuration -->
            <Border Style="{StaticResource CardStyle}" 
                    Visibility="{Binding DevMode, Converter={StaticResource VisibleForDevMode}}"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Deployment Configuration" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Deploy Type -->
                        <StackPanel Orientation="Horizontal" 
                                    Grid.Column="0" 
                                    Margin="0,0,16,0" 
                                    VerticalAlignment="Center"
                                    MinWidth="140">
                            <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                            <Label Content="Deploy Type:"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Left">
                            <RadioButton x:Name="ServerMode" 
                                        Content="Server" 
                                        GroupName="DeployType" 
                                        IsChecked="{Binding IsServerMode}"
                                        Style="{StaticResource ModernRadioButtonStyle}"/>
                            <RadioButton x:Name="ServerlessMode" 
                                        Style="{StaticResource ModernRadioButtonStyle}" 
                                        Content="Serverless" 
                                        GroupName="DeployType" 
                                        Margin="24,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Server Configuration -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Server Configuration" 
                               Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Height="1" Background="{StaticResource BorderColor}" Margin="0,8,0,0"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Primary Server -->
                        <StackPanel Orientation="Horizontal" 
                            Grid.Row="0" 
                            Grid.Column="0" 
                            Margin="0,0,16,16" 
                            VerticalAlignment="Center"
                            MinWidth="140">
                            <TextBlock Style="{StaticResource RequiredFieldStyle}"/>
                            <Label Content="Primary Server:"/>
                        </StackPanel>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <!-- ComboBox -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Domain -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- dấu : -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- Port -->
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ComboBox1" 
                                Grid.Column="0"
                                MinHeight="32"
                                Width="100"
                                HorizontalAlignment="Left"
                                SelectedIndex="{Binding Protocol1, Mode=TwoWay}"
                                Style="{StaticResource WebComboBoxStyle}">
                                <ComboBoxItem>http://</ComboBoxItem>
                                <ComboBoxItem>https://</ComboBoxItem>
                            </ComboBox>

                                <TextBox Grid.Column="1"
                                Margin="8,0,0,0"
                                Width="160"
                                MinHeight="32"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Padding="8,4"
                                Text="{Binding Domain1}"
                                LostFocus="TextBox_LostFocus" 
                                TextChanged="TextBox_TextChanged"
                                Style="{StaticResource ModernTextBoxStyle}"/>

                                            <TextBlock Grid.Column="2" 
                                Margin="8,0,0,0"
                                Text=":" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Left"
                                Foreground="{StaticResource TextSecondaryColor}"/>

                            <TextBox Grid.Column="3"
                                Margin="8,0,0,0"
                                Width="80"
                                MinHeight="32"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Padding="8,4"
                                Text="{Binding Port1}"
                                LostFocus="TextBox_LostFocus" 
                                TextChanged="TextBox_TextChanged"
                                Style="{StaticResource ModernTextBoxStyle}"/>
                        </Grid>

                        <!-- Secondary Server -->
                        <StackPanel Orientation="Horizontal" 
                            Grid.Row="1" 
                            Grid.Column="0" 
                            Margin="0,0,16,0" 
                            VerticalAlignment="Center"
                            MinWidth="140">
                            <Label Content="Secondary Server:"/>
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ComboBox2" 
                                Grid.Column="0"
                                MinHeight="32"
                                Width="100"
                                HorizontalAlignment="Left"
                                SelectedIndex="{Binding Protocol2, Mode=TwoWay}"
                                Style="{StaticResource WebComboBoxStyle}">
                                <ComboBoxItem>http://</ComboBoxItem>
                                <ComboBoxItem>https://</ComboBoxItem>
                            </ComboBox>

                            <TextBox Grid.Column="1"
                                Margin="8,0,0,0"
                                Width="160"
                                MinHeight="32"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Padding="8,4"
                                Text="{Binding Domain2}"
                                Style="{StaticResource ModernTextBoxStyle}"/>

                            <TextBlock Grid.Column="2" 
                                Margin="8,0,0,0"
                                Text=":" 
                                VerticalAlignment="Center" 
                                HorizontalAlignment="Left"
                                Foreground="{StaticResource TextSecondaryColor}"/>

                            <TextBox Grid.Column="3"
                                Margin="8,0,0,0"
                                Width="80"
                                MinHeight="32"
                                HorizontalAlignment="Left"
                                VerticalContentAlignment="Center"
                                Padding="8,4"
                                Text="{Binding Port2}"
                                Style="{StaticResource ModernTextBoxStyle}"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>