<UserControl x:Class="StorecfgGenerator.Views.Controls.TagInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40" d:DesignWidth="400"
             MinHeight="36"
             VerticalAlignment="Center"
             Loaded="UserControl_Loaded">
    <Border Background="{StaticResource BackgroundColor}"
            BorderBrush="{StaticResource BorderColor}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="8,4"
            MinHeight="36">
        <WrapPanel x:Name="PART_Wrap" Orientation="Horizontal" VerticalAlignment="Center">
            <ItemsControl x:Name="PART_Items" ItemsSource="{Binding Tags, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#e6f3ff"
                                BorderBrush="#40a9ff"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="6,2"
                                Margin="0,0,4,4">
                            <Border.RenderTransform>
                                <TranslateTransform X="-6"/>
                            </Border.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding}" Margin="2,0" VerticalAlignment="Center"/>
                                <Button Content="✕"
                                        Margin="4,0,0,0"
                                        Padding="0"
                                        Width="16" Height="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="RemoveTag_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)" From="-6" To="0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBox x:Name="PART_Input"
                     MinWidth="80"
                     Height="28"
                     Margin="0,0,0,0"
                     Style="{StaticResource ModernTextBoxStyle}"
                     BorderThickness="0"
                     Background="Transparent"
                     VerticalContentAlignment="Center"
                     KeyDown="InputTextBox_KeyDown"/>
        </WrapPanel>
    </Border>
</UserControl>


