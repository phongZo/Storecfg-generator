<UserControl x:Class="StorecfgGenerator.MarkerGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:TimeFormatConverter x:Key="TimeFormatConverter"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    
    <StackPanel Margin="24" Background="{StaticResource BackgroundColor}">
        <!-- Grid Settings Section -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <!-- Section Header -->
                <TextBlock Text="Grid Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Grid On -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Grid On:" FontWeight="Medium" VerticalAlignment="Center"/>
                    <ToggleButton Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ModernToggleButtonStyle}"
                                 IsChecked="{Binding CurrentEditingMarker.GridEnabled}" VerticalAlignment="Center"/>
                    
                    <!-- Grid Opacity -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Opacity:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="GridSlider" Margin="0,0,12,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                                SmallChange="0.01" LargeChange="0.1" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                Value="{Binding CurrentEditingMarker.GridOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource ModernSliderStyle}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="32" HorizontalAlignment="Stretch" 
                                VerticalAlignment="Center" VerticalContentAlignment="Center"
                                Text="{Binding CurrentEditingMarker.GridOpacity, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    
                    <!-- Show Timestamp -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Show Timestamp:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <ToggleButton Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ModernToggleButtonStyle}"
                                 IsChecked="{Binding CurrentEditingMarker.GridShowTimestamp}" VerticalAlignment="Center" Margin="0,20,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Grid Shape Configuration Section -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24">
            <StackPanel>
                <!-- Section Header -->
                <TextBlock Text="Shape Configuration" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Grid Shape -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Grid Shape:" FontWeight="Medium" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource WebComboBoxStyle}" 
                              SelectedIndex="{Binding CurrentGridShapeIndex, UpdateSourceTrigger=PropertyChanged, FallbackValue=0, TargetNullValue=0, ValidatesOnExceptions=False, ValidatesOnDataErrors=False}" 
                              Height="40" VerticalAlignment="Center">
                        <ComboBoxItem Tag="Shape">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F3F4F6" CornerRadius="4" Width="24" Height="24" Margin="0,0,12,0">
                                    <TextBlock Text="■" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Square" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="Shape">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F3F4F6" CornerRadius="12" Width="24" Height="24" Margin="0,0,12,0">
                                    <TextBlock Text="●" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Circle" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem x:Name="GridTypeLogoCombobox" Tag="Shape">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#F3F4F6" CornerRadius="4" Width="24" Height="24" Margin="0,0,12,0">
                                    <TextBlock Text="🖼️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Logo" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                    
                    <!-- Primary Logo -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Primary Logo:" FontWeight="Medium" VerticalAlignment="Center" 
                           Margin="0,20,0,0" Visibility="{Binding ElementName=GridTypeLogoCombobox, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="32" 
                             Text="{Binding CurrentEditingMarker.GridLogoURL, UpdateSourceTrigger=PropertyChanged}" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Visibility="{Binding ElementName=GridTypeLogoCombobox, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    
                    <!-- Secondary Logo -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Secondary Logo:" FontWeight="Medium" VerticalAlignment="Center" 
                           Margin="0,20,0,0" Visibility="{Binding ElementName=GridTypeLogoCombobox, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="32" 
                             Text="{Binding CurrentEditingMarker.GridSecondaryLogoURL, UpdateSourceTrigger=PropertyChanged}" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Visibility="{Binding ElementName=GridTypeLogoCombobox, Path=IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Cell Dimensions Section -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Section Header -->
                <TextBlock Text="Cell Dimensions" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,16"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Cell Width -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Cell Width:" FontWeight="Medium" VerticalAlignment="Center"/>
                    <Grid Grid.Row="0" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus"
                                 TextChanged="TextBox_TextChanged" Style="{StaticResource ModernTextBoxStyle}" Height="32"
                                 Text="{Binding CurrentEditingMarker.CellWidth, UpdateSourceTrigger=PropertyChanged}" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="px" VerticalAlignment="Center" Margin="8,0,0,0" 
                                   Foreground="{StaticResource TextMutedColor}" FontSize="12"/>
                    </Grid>
                    
                    <!-- Cell Height -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Cell Height:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus"
                                 TextChanged="TextBox_TextChanged" Style="{StaticResource ModernTextBoxStyle}" Height="32"
                                 Text="{Binding CurrentEditingMarker.CellHeight, UpdateSourceTrigger=PropertyChanged}" 
                                 HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="px" VerticalAlignment="Center" Margin="8,0,0,0" 
                                   Foreground="{StaticResource TextMutedColor}" FontSize="12"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
