<UserControl x:Class="StorecfgGenerator.MarkerText" 
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:TimeFormatConverter x:Key="TimeFormatConverter"/>
            <local:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <local:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <StackPanel Margin="0" Background="{StaticResource BackgroundColor}" VerticalAlignment="Top">
        <!-- Text Settings -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Text On -->
            <Label Grid.Row="0" Grid.Column="0" Content="Text On:" FontWeight="Medium" VerticalAlignment="Center"/>
            <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernToggleButtonStyle}"
                          IsChecked="{Binding CurrentEditingMarker.TextEnabled}" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            <!-- Opacity -->
            <Label Grid.Row="1" Grid.Column="0" Content="Opacity:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="TextSlider" Minimum="0" Maximum="1"
                        SmallChange="0.01" LargeChange="0.1"
                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding CurrentEditingMarker.TextOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        Style="{StaticResource ModernSliderStyle}"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Width="80" 
                         Height="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Text="{Binding CurrentEditingMarker.TextOpacity, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Grid>

        <!-- Text Content -->
        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Text To Display:" VerticalAlignment="Center" Grid.Column="0" FontWeight="Medium"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="TextToDisplayBox" Height="28" Style="{StaticResource ModernTextBoxStyle}"
                         Text="{Binding CurrentEditingMarker.TextFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         TextChanged="TextToDisplayBox_TextChanged"
                         PreviewKeyDown="TextToDisplayBox_PreviewKeyDown"
                         LostKeyboardFocus="TextToDisplayBox_LostKeyboardFocus"
                         Tag="required:Text To Display"/>
                <Popup x:Name="SuggestionPopup" Placement="Bottom" StaysOpen="True"
                       AllowsTransparency="True" Focusable="False" PlacementTarget="{Binding ElementName=TextToDisplayBox}">
                    <Border Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="6">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.12" BlurRadius="8"/>
                        </Border.Effect>
                        <ListBox x:Name="SuggestionList" Width="{Binding ElementName=TextToDisplayBox, Path=ActualWidth}"
                                 SelectionMode="Single" PreviewMouseLeftButtonDown="SuggestionList_PreviewMouseLeftButtonDown"/>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Text Appearance -->
        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Text Size -->
            <Label Grid.Row="0" Grid.Column="0" Content="Text Size:" FontWeight="Medium" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus"
                     TextChanged="TextBox_TextChanged" Style="{StaticResource ModernTextBoxStyle}" Height="28"
                     InputScope="Number" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="{Binding CurrentEditingMarker.TextSize}"
                     Tag="required:Text Size"/>

            <!-- Text Angle -->
            <Label Grid.Row="1" Grid.Column="0" Content="Text Angle:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="TextAngleSlider" HorizontalAlignment="Stretch" Minimum="0"
                        Maximum="360" SmallChange="1" LargeChange="10" 
                        Value="{Binding CurrentEditingMarker.TextAngle, Mode=TwoWay}" 
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        Style="{StaticResource ModernSliderStyle}"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Width="80" 
                         Height="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         Text="{Binding CurrentEditingMarker.TextAngle, Mode=TwoWay}"/>
            </Grid>

            <!-- Text Align By -->
            <Label Grid.Row="2" Grid.Column="0" Content="Text Align By:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="Spacing" Style="{StaticResource ModernRadioButtonStyle}" 
                             IsChecked="{Binding CurrentEditingMarker.TextSpacingEnabled}" 
                             Margin="0,0,16,0" VerticalAlignment="Center"/>
                <RadioButton Content="Column x Row" Style="{StaticResource ModernRadioButtonStyle}" 
                             IsChecked="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource InverseBooleanConverter}}" 
                             VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Text Columns (Column x Row mode) -->
            <Label Grid.Row="3" Grid.Column="0" Content="Text Columns:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"
                   Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28" Margin="0,16,0,0"
                     Text="{Binding CurrentEditingMarker.TextCols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

            <!-- Text Rows (Column x Row mode) -->
            <Label Grid.Row="4" Grid.Column="0" Content="Text Rows:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"
                   Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>
            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28" Margin="0,16,0,0"
                     Text="{Binding CurrentEditingMarker.TextRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"/>

        </Grid>

        <!-- Text Spacing Settings -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Text Spacing X (Spacing mode only) -->
            <Label Grid.Row="0" Grid.Column="0" Content="Text Spacing X:" FontWeight="Medium" VerticalAlignment="Center"
                   Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28"
                     Text="{Binding CurrentEditingMarker.TextSpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus" TextChanged="TextBox_TextChanged"
                     InputScope="Number"
                     Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Tag="required:Text Spacing X"/>

            <!-- Text Spacing Y (Spacing mode only) -->
            <Label Grid.Row="1" Grid.Column="0" Content="Text Spacing Y:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"
                   Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28"
                     Text="{Binding CurrentEditingMarker.TextSpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus" TextChanged="TextBox_TextChanged"
                     InputScope="Number" Margin="0,16,0,0"
                     Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Tag="required:Text Spacing Y"/>

            <!-- Text Adjustment (Spacing mode only) -->
            <Label Grid.Row="2" Grid.Column="0" Content="Text Adjustment:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"
                   Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0" Orientation="Vertical" VerticalAlignment="Center"
                        Visibility="{Binding CurrentEditingMarker.TextSpacingEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ToggleButton Style="{StaticResource ModernToggleButtonStyle}"
                              IsChecked="{Binding CurrentEditingMarker.TextAdjustment}" 
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <TextBlock Text="Auto adjust Text Spacing in case text is overlapped." 
                           FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Text Color 1 -->
            <Label Grid.Row="3" Grid.Column="0" Content="Text Color 1:" FontWeight="Medium" VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="24" Height="24" Background="{Binding CurrentEditingMarker.TextColor1}" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="2"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28" Margin="8,0,0,0"
                         Text="{Binding CurrentEditingMarker.TextColor1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Text Color 2 -->
            <Label Grid.Row="4" Grid.Column="0" Content="Text Color 2:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="24" Height="24" Background="{Binding CurrentEditingMarker.TextColor2}" 
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="2"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28" Margin="8,0,0,0"
                         Text="{Binding CurrentEditingMarker.TextColor2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
            </Grid>

            <!-- Text Blur Radius -->
            <Label Grid.Row="5" Grid.Column="0" Content="Text Blur Radius:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28"
                     Text="{Binding CurrentEditingMarker.TextBlurRadius, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     PreviewTextInput="TextBox_PreviewTextInput" LostFocus="TextBox_LostFocus" TextChanged="TextBox_TextChanged"
                     InputScope="Number" Margin="0,16,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
