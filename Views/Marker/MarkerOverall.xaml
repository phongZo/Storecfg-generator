<UserControl x:Class="StorecfgGenerator.MarkerOverall"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator" d:DataContext="{d:DesignInstance Type=local:StoreCfgJson}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:TimeFormatConverter x:Key="TimeFormatConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    
    <StackPanel Margin="0" VerticalAlignment="Stretch" Background="{StaticResource BackgroundColor}">
        <!-- Drawing Settings -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Drawing On -->
            <Label Grid.Row="0" Grid.Column="0" Content="Drawing On:" FontWeight="Medium" VerticalAlignment="Center"/>
            <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernToggleButtonStyle}"
                         IsChecked="{Binding CurrentEditingMarker.DrawingEnabled}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
            
            <!-- Drawing Opacity -->
            <Label Grid.Row="1" Grid.Column="0" Content="Drawing Opacity:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="OverallSlider" Minimum="0" Maximum="1"
                        SmallChange="0.01" LargeChange="0.1"
                        TickFrequency="0.01" IsSnapToTickEnabled="True"
                        Value="{Binding CurrentEditingMarker.Opacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        Style="{StaticResource ModernSliderStyle}"/>
                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Width="80" 
                        Height="28" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                        Text="{Binding CurrentEditingMarker.Opacity, Mode=TwoWay, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>
        </Grid>

        <!-- Timestamp Format -->
        <Grid Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Label Grid.Row="0" Grid.Column="0" Content="Timestamp Format:" FontWeight="Medium" VerticalAlignment="Center"/>
            <TextBox x:Name="timeFormatTextBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Text="{Binding CurrentEditingMarker.TimestampFormat, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Preview: " Foreground="#999" Visibility="Collapsed" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="currentTimeTextBlock" Width="Auto" HorizontalAlignment="Left"
                       Text="{Binding ElementName=timeFormatTextBox, Path=Text, Converter={StaticResource TimeFormatConverter}}" 
                       Visibility="Collapsed" Margin="0,8,0,0"/>
        </Grid>
    </StackPanel>
</UserControl>
