<UserControl x:Class="StorecfgGenerator.MarkerLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StorecfgGenerator"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <local:TimeFormatConverter x:Key="TimeFormatConverter"/>
            <local:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    
    <StackPanel Margin="0" Background="{StaticResource BackgroundColor}">
            <!-- Logo Settings -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Logo On -->
                <Label Grid.Row="0" Grid.Column="0" Content="Logo On:" FontWeight="Medium" VerticalAlignment="Center"/>
                <ToggleButton Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ModernToggleButtonStyle}"
                             IsChecked="{Binding CurrentEditingMarker.LogoEnabled}" VerticalAlignment="Center"/>
                
                <!-- Logo Opacity -->
                <Label Grid.Row="1" Grid.Column="0" Content="Opacity:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" x:Name="SliderLogo" Margin="0,0,8,0" VerticalAlignment="Center" Minimum="0" Maximum="1"
                            SmallChange="0.01" LargeChange="0.1" 
                            Value="{Binding CurrentEditingMarker.LogoOpacity, Mode=TwoWay}"
                            Style="{StaticResource ModernSliderStyle}"/>
                    <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Height="28" HorizontalAlignment="Stretch" 
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            Text="{Binding CurrentEditingMarker.LogoOpacity, Mode=TwoWay, StringFormat={}{0:F2}}"/>
                </Grid>
                
                <!-- Show Timestamp -->
                <Label Grid.Row="2" Grid.Column="0" Content="Show Timestamp:" FontWeight="Medium" VerticalAlignment="Center" Margin="0,16,0,0"/>
                <ToggleButton Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource ModernToggleButtonStyle}"
                             IsChecked="{Binding CurrentEditingMarker.LogoShowTimestamp}" VerticalAlignment="Center" Margin="0,16,0,0"/>
            </Grid>
            
            <!-- Logo Position -->
            <StackPanel Margin="0,16,0,0">
                <Label Content="Logo Position:" FontWeight="Medium" Margin="0,0,0,8"/>
                <Grid x:Name="LogoPositionGrid" Margin="0,8,0,0" Width="300" HorizontalAlignment="Left">
                    <Image Source="/Icon/desktop.png"/>
                    <ItemsControl ItemsSource="{Binding LogoPosition2, Mode=TwoWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="3" Style="{StaticResource CellBorderStyle}"
                                        Background="{Binding Value, Converter={StaticResource BooleanToColorConverter}}" 
                                        MouseLeftButtonUp="Border_MouseLeftButtonUp"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="{Binding RowIndex}" Columns="{Binding ColumnIndex}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </StackPanel>
</UserControl>
